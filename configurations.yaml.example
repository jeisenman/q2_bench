# Per-user configuration. Copy to configurations.yaml, which is gitignored.
#
#   cp configurations.yaml.example configurations.yaml
#
# This file names environment variables. It never holds their values: tokens
# live in .env or your shell profile and resolve at call time.
#
# Every workspace is disabled by default. An absent workspace, or an absent
# `enabled`, is false. Turn on only what you need.

version: 1

workspaces:
  data_engineering:
    enabled: false

    # Parent directory containing all local Data Engineering repository
    # checkouts. Run `uv run agentbench setup` to choose and create it.
    repositories:
      root: ~/ra
      # Contx checkout containing Metadata/<environment> JSON snapshots.
      # The active branch supplies the metadata, currently DE-3041.
      contx: ~/ra/contx

    # Keys below are keys into DATABRICKS_TARGETS in
    # src/adapters/outbound/data_engineering/targets.py. A key with no registry
    # entry fails at load.
    databricks:
      # RA preprod — pl-databricks-us-rapreprod-01. Non-production.
      ra:
        enabled: false
        auth: pat
        host_env: RA_DATABRICKS_HOST
        token_env: RA_DATABRICKS_TOKEN
        cluster: radar-264227


      # Data Engineering PRODUCTION — pl-databricks-us-prod-01.
      # Production data. Requires enabled: true on BOTH this environment and
      # the workspace above. Two deliberate edits, never one.
      de:
        enabled: false
        auth: pat
        host_env: DE_DATABRICKS_HOST
        token_env: DE_DATABRICKS_TOKEN
        cluster: pl-databricks-us-prod-01

    # Airflow connections, one per deployment. Each entry names environment
    # variables; values live in .env. Every key is required: a missing entry,
    # key, or variable value raises AirflowConfigurationError. Production
    # support reads produs (US-01) and prodca (CA-02).
    airflow:
      alpha:
        host_env: ALPHAAIRFLOWHOST
        user_env: ALPHAAIRFLOWUSER
        password_env: ALPHAAIRFLOWPASSWORD

      staging:
        host_env: STAGINGAIRFLOWHOST
        user_env: STAGINGAIRFLOWUSER
        password_env: STAGINGAIRFLOWPASSWORD

      # PRODUCTION. The user variables keep the legacy AIRFLOR spelling.
      produs:
        host_env: USAIRFLOWHOST
        user_env: USAIRFLORUSER
        password_env: USAIRFLOWPASSWORD

      prodca:
        host_env: CAAIRFLOWHOST
        user_env: CAAIRFLORUSER
        password_env: CAAIRFLOWPASSWORD
      
      oms:
        pl-oms-us-primary: 71aa0ec0-8411-43a2-9908-ddd2add764eb
        pl-oms-ca-primary: cde221ff-e7f4-4d39-be20-6f9d532cab60
      
  