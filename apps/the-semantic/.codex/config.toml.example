# Copy to .codex/config.toml in this worktree after building the Rust binary.
# Update the absolute path if this worktree moves. No credentials belong here.
[mcp_servers.semantic_research]
command = "/Users/jeisenman/ra/worktrees/the-semantic/scaffold-mvp/target/debug/researcher-codex"
args = ["mcp"]
startup_timeout_sec = 15
tool_timeout_sec = 320
required = true

[mcp_servers.semantic_research.env]
SEMANTIC_API_URL = "http://127.0.0.1:5056"
Q2_MCP_DEBUG = "1"
