# Airflow production access
# AIRFLOR is the established legacy spelling required by the adapter.
USAIRFLORUSER=
USAIRFLOWPASSWORD=
CAAIRFLORUSER=
CAAIRFLOWPASSWORD=
PROD_SUPPORT_UPDATES_PATH=

# PrecisionLender Resource Discovery
RESOURCE_DISCOVERY_BASE_URL=
RESOURCE_DISCOVERY_CLIENT_ID=
RESOURCE_DISCOVERY_CLIENT_SECRET=
RESOURCE_DISCOVERY_SCOPE=
RESOURCE_DISCOVERY_TENANT_ID=
# Non-secret UUID used only by opt-in production connectivity checks.
RESOURCE_DISCOVERY_TEST_CLIENT_ID=

# Databricks tokens are workspace-scoped: one token authenticates against one
# workspace only. Mint a separate token per environment. See SETUP.md.

# Databricks RA preprod — pl-databricks-us-rapreprod-01 (7628572648057993).
# The only RA environment currently registered.
RA_DATABRICKS_HOST=https://adb-7628572648057993.13.azuredatabricks.net
RA_DATABRICKS_TOKEN=

# Databricks Data Engineering PRODUCTION — pl-databricks-us-prod-01
# (3510128597187204). This is production data. It stays disabled in
# configurations.yaml until you enable it deliberately.
DE_DATABRICKS_HOST=
DE_DATABRICKS_TOKEN=

# AWS Bedrock access
AWS_CA_BUNDLE=/home/agentbench/.aws/q2-ca-bundle.pem
